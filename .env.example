# Local development defaults.
# Docker Compose already has these defaults built in, so this file is optional.

POSTGRES_USER=surveillance
POSTGRES_PASSWORD=surveillance
POSTGRES_DB=surveillance

DATABASE_URL=postgres://surveillance:surveillance@postgres:5432/surveillance
REDIS_URL=redis://redis:6379
JWT_SECRET=change-me-in-production
API_PORT=3000

PUBLIC_API_URL=http://localhost:3000
PUBLIC_WS_URL=ws://localhost:3000/ws
PUBLIC_WEBRTC_BASE_URL=http://localhost:8889

ALERT_DEDUPE_SECONDS=10

MEDIAMTX_RTSP_URL=rtsp://mediamtx:8554
WORKER_CONSUMER_NAME=worker-1
DETECTION_CONFIDENCE=0.35
DETECTION_INTERVAL_MS=500
